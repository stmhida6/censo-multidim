    <Compile Include="..\Censo.Pruebas.BaseDatos\Ayudantes\ValoresEsperados.cs" Link="Ayudantes\ValoresEsperados.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Censo.Api\Censo.Api.csproj" />
