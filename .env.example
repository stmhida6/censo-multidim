# Copia este archivo a ".env" y reemplaza los valores. No pongas secretos reales en .env.example.

# --- SQL Server ---
# Debe cumplir la política de contraseñas fuertes de SQL Server (min. 8 caracteres,
# mayúscula, minúscula, número y símbolo).
MSSQL_SA_PASSWORD=CAMBIA_ESTA_CLAVE_Str0ng!
MSSQL_PID=Developer
SQLSERVER_PORT=1433
DB_NAME=CensoGT2018

# Clave del usuario de solo lectura de la API (login CensoApi); minimo 12 caracteres.
# Se crea con: bash db/crear-usuario-api.sh
CLAVE_API=CAMBIA_ESTA_CLAVE_Api_Str0ng!

# Memoria interna de SQL Server (MB). Debe ser menor que DB_MEM_LIMIT.
DB_MEMORY_LIMIT_MB=3072

# Límites de recursos del contenedor de SQL Server (laptop de 16 GB, compartida con Power BI).
DB_MEM_LIMIT=4g
DB_MEM_RESERVATION=2g
DB_CPU_LIMIT=2

# --- API (.NET 8) ---
ASPNETCORE_ENVIRONMENT=Development
API_HTTP_PORT=5000
# Solicitudes por minuto por cliente (limitador de la API). La prueba de carga lo sube temporalmente.
API_LIMITE_POR_MINUTO=120
# Tiempo maximo de una consulta en la base, en segundos (criterio de aceptacion: hasta 90 s).
API_TIEMPO_ESPERA_SEGUNDOS=90

# --- ETL (microdatos del INE) ---
# Carpeta con VIVIENDA_BDP.sav, HOGAR_BDP.sav, "PERSONA - BDP.sav" y MIGRACION_BDP.sav (por defecto datos/microdatos).
MICRODATOS_DIR=datos/microdatos
# Ruta de Rscript si no esta en el PATH (por ejemplo, /c/Program Files/R/R-4.5.2/bin/Rscript.exe en Git Bash).
# RSCRIPT=

# --- Despliegue en Azure (despliegue/scripts) ---
# Region permitida por la suscripcion y con oferta gratuita de Azure SQL.
AZURE_RESOURCE_GROUP=rg-censo2018
AZURE_LOCATION=westus
AZURE_SQL_ADMIN=censoadmin
AZURE_APP_PLAN=plan-censo2018
# Los scripts generan y agregan aqui: AZURE_SQL_SERVER, AZURE_SQL_ADMIN_PASSWORD, AZURE_CLAVE_API y AZURE_APP_NAME.
